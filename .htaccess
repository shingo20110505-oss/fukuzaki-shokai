SetEnvIf Request_URI ".*" Ngx_Cache_NoCacheMode=off
SetEnvIf Request_URI ".*" Ngx_Cache_AllCacheMode

# Keep HTML/text responses fresh after deployments while preserving cache for CSS/JS/images.
<IfModule mod_headers.c>
  <FilesMatch "\.(html?|xml|txt)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

DirectoryIndex index.html
Options -MultiViews
RewriteEngine On
RewriteCond %{HTTPS} !on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

ErrorDocument 404 /404.html

# Preserve clean URLs while serving static pages.
RewriteRule ^sales/?$ sales.html [L]
RewriteRule ^repair/?$ repair.html [L]
RewriteRule ^models/?$ models.html [L]
RewriteRule ^works/handa-amos-rexx/?$ works-handa-amos-rexx.html [L]
RewriteRule ^works/anjo-repair/?$ works-anjo-repair.html [L]
RewriteRule ^works/yokkaichi-repair/?$ works-yokkaichi-repair.html [L]
RewriteRule ^works/?$ works.html [L]
RewriteRule ^company/?$ company.html [L]
RewriteRule ^faq/?$ faq.html [L]
RewriteRule ^contact/?$ contact.html [L]
RewriteRule ^privacy/?$ privacy.html [L]
RewriteRule ^404/?$ 404.html [L]
