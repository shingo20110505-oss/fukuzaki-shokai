SetEnvIf Request_URI ".*" Ngx_Cache_NoCacheMode=off
SetEnvIf Request_URI ".*" Ngx_Cache_AllCacheMode

DirectoryIndex index.html
Options -MultiViews
RewriteEngine On
RewriteCond %{HTTPS} !on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

ErrorDocument 404 /404.html

# Preserve former clean URLs while serving static pages.
RewriteRule ^sales/?$ sales.html [L]
RewriteRule ^repair/?$ repair.html [L]
RewriteRule ^models/?$ models.html [L]
RewriteRule ^works/?$ works.html [L]
RewriteRule ^company/?$ company.html [L]
RewriteRule ^faq/?$ faq.html [L]
RewriteRule ^contact/?$ contact.html [L]
RewriteRule ^privacy/?$ privacy.html [L]
RewriteRule ^404/?$ 404.html [L]
